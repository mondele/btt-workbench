function NameWordOf(CodePoint: Cardinal): Integer;
var
  Lo, Hi, Mid: Integer;
begin
  Lo := 0;
  Hi := RunCount - 1;
  while Lo < Hi do
  begin
    Mid := (Lo + Hi + 1) div 2;
    if RunStarts[Mid] <= CodePoint then
      Lo := Mid
    else
      Hi := Mid - 1;
  end;
  Result := RunNames[Lo];
end;

function NameWord(Index: Integer): string;
begin
  Result := NameWords[Index];
end;

