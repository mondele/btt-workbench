unit WBUnicodeNames;

{$mode objfpc}{$H+}

{ The first word of each code point's Unicode character name (Unicode
  15.0.0), as Python's unicodedata.name(c).split()[0] gives it:
  usfm-tools' usfm_utils.unicodeBlock/isCaseless decide a word's script by
  the most common of these. Generated from Python's unicodedata; do not
  edit by hand. }

interface

{ Index into NameWords of the code point's first name word. }
function NameWordOf(CodePoint: Cardinal): Integer;
function NameWord(Index: Integer): string;
{ True for the scripts usfm_utils.isCaseless lists (no capital letters). }
function IsCaselessName(Index: Integer): Boolean;

