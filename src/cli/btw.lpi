<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="btw"/>
    </General>
    <VersionInfo>
      <UseVersionInfo Value="True"/>
      <MinorVersionNr Value="2"/>
      <StringTable CompanyName="Wycliffe Associates" FileDescription="BTT Workbench command line" InternalName="btw" LegalCopyright="MIT licence" OriginalFilename="btw.exe" ProductName="BTT Workbench" ProductVersion="0.2.0"/>
    </VersionInfo>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <RequiredPackages>
      <Item>
        <PackageName Value="LazUtils"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="btw.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="../../bin/btw"/>
    </Target>
    <SearchPaths>
      <OtherUnitFiles Value="../core;../modules"/>
      <UnitOutputDirectory Value="../../lib/$(TargetCPU)-$(TargetOS)/cli"/>
    </SearchPaths>

  </CompilerOptions>
</CONFIG>
