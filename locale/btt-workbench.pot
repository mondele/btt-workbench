msgid "Package file"
msgstr ""

#: modtstudioimport:rsoptfilehelp
msgid "The .tstudio file to import"
msgstr ""

#: modtstudioimport:rsoptonexisting
msgid "If the project exists"
msgstr ""

#: modtstudioimport:rsoptonexistinghelp
msgid ""
"stop: change nothing; merge: combine with the existing project (as BTT-"
"Writer does); overwrite: replace it (the old copy is kept in workbench-"
"backups)"
msgstr ""

