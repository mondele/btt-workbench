msgid "A project named %s already exists."
msgstr ""

#: modtstudioimport:rslocalnotrepo
msgid ""
"The existing %s is not a git repository, so it cannot be merged. Use "
"overwrite (the old copy is backed up) or fix it first."
msgstr ""

#: modtstudioimport:rslocalmidmerge
msgid ""
"The existing %s has an unfinished merge. Finish or abort it in BTT-Writer "
"first. Nothing changed."
msgstr ""

#: modtstudioimport:rslocaldirty
msgid ""
"The existing project has uncommitted changes. A merge will commit them "
"first; the conflict list below does not include them."
msgstr ""

#: modtstudioimport:rsuptodate
msgid ""
"The existing project already contains everything in the package. Nothing to "
"import."
msgstr ""

#: modtstudioimport:rsfastforward
msgid ""
"The package only adds newer work to the existing project. A merge will have "
"no conflicts."
msgstr ""

#: modtstudioimport:rscleanmerge
msgid "Both copies have changes. A merge will combine them with no conflicts."
msgstr ""

#: modtstudioimport:rsunrelated
msgid ""
"The two copies were started separately (no shared history), so every chunk "
"that differs will conflict."
msgstr ""

#: modtstudioimport:rsconflictcount
msgid ""
"A merge would leave %d chunk(s) in conflict, to be resolved in BTT-Writer: %s"
msgstr ""

#: modtstudioimport:rsconflictfiles
msgid "Other files in conflict: %s"
msgstr ""

#: modtstudioimport:rsreopened
msgid "These finished chunks would be marked unfinished again: %s"
msgstr ""

#: modtstudioimport:rsmanifestmerged
msgid ""
"manifest.json differs; it is merged automatically (translators and finished "
"chunks are combined)."
msgstr ""

#: modtstudioimport:rschooseaction
msgid "To import it, choose merge or overwrite."
msgstr ""

#: modtstudioimport:rsstopped
msgid ""
"%s already exists. Choose merge or overwrite to import it. Nothing changed."
msgstr ""

#: modtstudioimport:rspreflightfailed
msgid "Could not check the merge: %s"
msgstr ""

#: modtstudioimport:rssnapshot
msgid "Committed uncommitted changes in the existing project first."
msgstr ""

#: modtstudioimport:rsmerged
msgid "Merged into %s."
msgstr ""

#: modtstudioimport:rsmergedconflicts
msgid ""
"Merged into %s with %d chunk(s) in conflict. Open the project in BTT-Writer "
"to choose between the versions."
msgstr ""

#: modtstudioimport:rsmergefailed
msgid "Merge failed: %s. The existing project was left as it was."
msgstr ""

#: modtstudioimport:rsbackedup
msgid "The existing project was moved to %s."
msgstr ""

#: modtstudioimport:rsoverwritten
msgid "Replaced %s with the imported copy."
msgstr ""

#: modtstudioimport:rsmovefailed
msgid "Could not move %s to %s. Nothing changed."
msgstr ""

