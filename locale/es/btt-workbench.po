msgstr "Se importó %s."

#: wbimport:rsexists
msgid "A project named %s already exists."
msgstr "Ya existe un proyecto llamado %s."

#: wbimport:rslocalnotrepo
msgid "The existing %s is not a git repository, so it cannot be merged. Use overwrite (the old copy is backed up) or fix it first."
msgstr "%s existente no es un repositorio git, por lo que no se puede fusionar. Use sobrescribir (se hace copia de seguridad de la copia anterior) o corríjalo primero."

#: wbimport:rslocalmidmerge
msgid "The existing %s has an unfinished merge. Finish or abort it in BTT-Writer first. Nothing changed."
msgstr "%s existente tiene una fusión sin terminar. Termínela o cancélela primero en BTT-Writer. No se cambió nada."

#: wbimport:rslocaldirty
msgid "The existing project has uncommitted changes. A merge will commit them first; the conflict list below does not include them."
msgstr "El proyecto existente tiene cambios sin confirmar. Una fusión los confirmará primero; la lista de conflictos de abajo no los incluye."

