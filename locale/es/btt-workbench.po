msgstr "Guardado."

#: modsettings:rssettingsfile
msgid "Settings file: %s"
msgstr "Archivo de configuración: %s"

#: modsettings:rsdata
msgid "BTT-Writer data folder: %s (%s)"
msgstr "Carpeta de datos de BTT-Writer: %s (%s)"

#: modsettings:rsfromenv
msgid "from %s"
msgstr "de %s"

#: modsettings:rsfromsetting
msgid "saved setting"
msgstr "configuración guardada"

#: modsettings:rsfromdefault
msgid "BTT-Writer's usual place"
msgstr "ubicación habitual de BTT-Writer"

#: modsettings:rssources
