msgstr "Textos fuente de BTT-Writer: no encontrados. La fragmentación solo se puede revisar con las fuentes que BTT-Writer ha descargado. Use --btt-writer para indicar dónde está instalado BTT-Writer."

#: modsettings:rsbadsetting
msgid "The saved BTT-Writer location %s has no source texts any more."
msgstr "La ubicación guardada de BTT-Writer %s ya no tiene textos fuente."

#: modsettings:rsotherinstalls
msgid "Other BTT-Writer installs found: %s"
msgstr "Otras instalaciones de BTT-Writer encontradas: %s"

#: modtextcheck:rstitle
msgid "Translation text checks"
msgstr "Revisiones del texto de traducción"

#: modtextcheck:rsdescription
msgid "Checks the text of translation projects for verse, marker, punctuation, quote and number problems, using the checks of usfm-tools' verifyUSFM. Changes nothing."
msgstr "Revisa el texto de los proyectos de traducción en busca de problemas de versículos, marcadores, puntuación, comillas y números, usando las revisiones de verifyUSFM de usfm-tools. No cambia nada."

#: modtextcheck:rsoptlanguagehelp
msgid "Only these target language codes, comma-separated"
msgstr "Solo estos códigos de idioma de destino, separados por comas"

#: modtextcheck:rsoptskip
msgid "Skip checks"
msgstr "Omitir revisiones"

#: modtextcheck:rsoptskiphelp
msgid "Groups of checks to leave out, comma-separated: structure, markers, punctuation, quotes, numbers, ascii, caps, source, words, headings, footnotes, brackets"
msgstr "Grupos de revisiones que se omiten, separados por comas: structure, markers, punctuation, quotes, numbers, ascii, caps, source, words, headings, footnotes, brackets"

#: modtextcheck:rsoptproblemsonlyhelp
msgid "List only projects with findings"
msgstr "Mostrar solo los proyectos con hallazgos"

#: modtextcheck:rsbadskip
msgid "Unknown check group \"%s\". Use: %s"
msgstr "Grupo de revisión desconocido \"%s\". Use: %s"

#: modtextcheck:rsheader
msgid "%s: %s (%s), %s - %d finding(s)"
msgstr "%s: %s (%s), %s - %d hallazgo(s)"

