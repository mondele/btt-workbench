msgid "Unsupported package version %s."
msgstr "Versión de paquete no admitida: %s."

#: modtstudioimport:rsemptypackage
msgid "The package contains no projects."
msgstr "El paquete no contiene proyectos."

#: modtstudioimport:rspackageinfo
