#: wbimport:rsbranchrenamed
msgid "The git branch was main; moved it to master, the only branch BTT-Writer uses."
msgstr "La rama de git era main; se movió a master, la única rama que usa BTT-Writer."

#: wbimport:rsbranchwouldrename
msgid "The git branch is main, but BTT-Writer only uses master; it would be moved to master (dry run)."
msgstr "La rama de git es main, pero BTT-Writer solo usa master; se movería a master (simulación)."

#: wbimport:rsbranchboth
msgid "The project is on git branch main, and a master branch exists too; not changed. BTT-Writer only uses master, so merge main into master by hand."
msgstr "El proyecto está en la rama main de git y también existe una rama master; no se cambió. BTT-Writer solo usa master, así que fusione main en master manualmente."

#: wbimport:rsbranchother
msgid "The git branch is %s, not master; BTT-Writer only uses master."
msgstr "La rama de git es %s, no master; BTT-Writer solo usa master."

#: wbimport:rsdetached
msgid "git is not on any branch (detached HEAD); BTT-Writer only uses master."
msgstr "git no está en ninguna rama (HEAD desacoplado); BTT-Writer solo usa master."

#: wbimport:rsbranchfailed
msgid "Could not move the git branch from main to master: %s"
msgstr "No se pudo mover la rama de git de main a master: %s"

