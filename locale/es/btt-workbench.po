msgid "The .tstudio file(s) to import, in order"
msgstr "Los archivos .tstudio que se importarán, en orden"

#: modtstudioimport:rsoptonexisting
msgid "If the project exists"
msgstr "Si el proyecto ya existe"

#: modtstudioimport:rsoptonexistinghelp
msgid "stop: change nothing; merge: combine with the existing project (as BTT-Writer does); overwrite: replace it (the old copy is kept in workbench-backups)"
msgstr "stop: no cambiar nada; merge: combinar con el proyecto existente (como hace BTT-Writer); overwrite: reemplazarlo (la copia anterior se conserva en workbench-backups)"

#: modtstudioimport:rsoptdryrunhelp
msgid "Report what the import would do without changing anything"
msgstr "Informar qué haría la importación sin cambiar nada"

