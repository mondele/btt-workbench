msgid "%s is an older project format (version %s). Import it with BTT-Writer, which can upgrade it. Skipped."
msgstr "%s tiene un formato de proyecto más antiguo (versión %s). Impórtelo con BTT-Writer, que puede actualizarlo. Omitido."

#: wbimport:rsmigratedv7
msgid "Upgraded the project format from version 7 to 8, as BTT-Writer does."
msgstr "Se actualizó el formato del proyecto de la versión 7 a la 8, como lo hace BTT-Writer."

#: wbimport:rsrenamedbranch
msgid "Renamed the package's branch \"%s\" to \"master\", which BTT-Writer expects."
msgstr "Se renombró la rama \"%s\" del paquete a \"master\", que es la que BTT-Writer espera."

#: wbimport:rsnewprojectversion
msgid "%s uses a newer project format (version %s) than this tool knows. Skipped."
msgstr "%s usa un formato de proyecto más nuevo (versión %s) del que esta herramienta conoce. Omitido."

