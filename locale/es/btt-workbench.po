msgstr "Primero se confirmaron los cambios sin confirmar del proyecto existente."

#: wbimport:rsmerged
msgid "Merged into %s."
msgstr "Fusionado en %s."

#: wbimport:rsmergedconflicts
msgid "Merged into %s with %d chunk(s) in conflict. Open the project in BTT-Writer to choose between the versions."
msgstr "Fusionado en %s con %d fragmento(s) en conflicto. Abra el proyecto en BTT-Writer para elegir entre las versiones."

#: wbimport:rsmergefailed
msgid "Merge failed: %s. The existing project was left as it was."
msgstr "Falló la fusión: %s. El proyecto existente se dejó como estaba."

#: wbimport:rsbackedup
msgid "The existing project was moved to %s."
msgstr "El proyecto existente se movió a %s."

#: wbimport:rsoverwritten
msgid "Replaced %s with the imported copy."
msgstr "Se reemplazó %s con la copia importada."

#: wbimport:rsexistsearlier
msgid "%s is also in an earlier package; checking against that result."
msgstr "%s también está en un paquete anterior; se revisa contra ese resultado."

