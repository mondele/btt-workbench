msgid "Files that differ from the last commit (BTT-Writer will commit them): %d."
msgstr "Archivos que difieren del último commit (BTT-Writer los confirmará): %d."

#: wbimport:rsgitrepairfailed
msgid "Could not rebuild them (%s); left as it was."
msgstr "No se pudieron reconstruir (%s); se dejó como estaba."

#: wbimport:rsgitnobranch
msgid "The .git folder has no HEAD and no branch to point it at, so it cannot be rebuilt here."
msgstr "La carpeta .git no tiene HEAD ni una rama a la cual apuntar, por lo que no se puede reconstruir aquí."

#: wbimport:rsnoprojectmanifest
