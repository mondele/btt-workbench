msgstr "%d de %d fragmentos terminados"

#: modprojects:rsprogressfiles
msgid "%d chunk files, %d finished"
msgstr "%d archivos de fragmentos, %d terminados"

#: modprojects:rsstrayfile
msgid "%s: a file, not a project folder."
msgstr "%s: es un archivo, no una carpeta de proyecto."

#: modprojects:rsnomanifest
msgid "%s: no manifest.json, so this is not a BTT-Writer project (or it is damaged)."
msgstr "%s: no hay manifest.json, por lo que no es un proyecto de BTT-Writer (o está dañado)."

#: modprojects:rsmanifestconflict
msgid "manifest.json has unresolved merge conflict markers, so BTT-Writer cannot open the project."
msgstr "manifest.json tiene marcadores de conflicto de fusión sin resolver, por lo que BTT-Writer no puede abrir el proyecto."

#: modprojects:rsmanifestinvalid
msgid "manifest.json cannot be read (%s)."
msgstr "No se puede leer manifest.json (%s)."

#: modprojects:rsmanifestids
msgid "manifest.json is missing the language, book or type."
msgstr "A manifest.json le falta el idioma, el libro o el tipo."

#: modprojects:rsmanifesttypes
msgid "manifest.json has fields that are missing or of the wrong type: %s"
msgstr "manifest.json tiene campos que faltan o son de un tipo incorrecto: %s"

#: modprojects:rsmatchedbyfolder
msgid "Listed by its folder name, as the manifest cannot be read."
msgstr "Listado por el nombre de su carpeta, ya que no se puede leer el manifiesto."

#: modprojects:rsoldformat
msgid "Older project format (version %s); BTT-Writer upgrades it when the project is opened."
msgstr "Formato de proyecto anterior (versión %s); BTT-Writer lo actualiza al abrir el proyecto."

#: modprojects:rsnewformat
msgid "Project format version %s is newer than this tool knows; checks may be incomplete."
msgstr "La versión %s del formato del proyecto es más reciente de lo que esta herramienta conoce; es posible que las revisiones estén incompletas."

#: modprojects:rsfoldername
msgid "The folder should be named %s. BTT-Writer matches projects by folder name, so imports of this project will not merge with it."
msgstr "La carpeta debería llamarse %s. BTT-Writer asocia los proyectos por el nombre de la carpeta, por lo que las importaciones de este proyecto no se fusionarán con él."

#: modprojects:rsnogit
msgid "No git history. BTT-Writer cannot save versions of this project or merge it."
msgstr "Sin historial de git. BTT-Writer no puede guardar versiones de este proyecto ni fusionarlo."

#: modprojects:rsbadgit
msgid "The git history is damaged or empty."
msgstr "El historial de git está dañado o vacío."

#: modprojects:rsmidmerge
msgid "An unfinished merge is in progress."
msgstr "Hay una fusión sin terminar en curso."

#: modprojects:rsdirty
msgid "Has changes that are not committed yet."
msgstr "Tiene cambios que aún no se han confirmado."

#: modprojects:rsfsck
msgid "git fsck found problems in the history: %s"
msgstr "git fsck encontró problemas en el historial: %s"

#: modprojects:rssummaryrenamed
msgid "%d project(s) moved from git branch main to master."
msgstr "%d proyecto(s) pasaron de la rama main de git a master."

#: modprojects:rssummaryrebuilt
msgid "%d project(s) had their .git folder rebuilt."
msgstr "A %d proyecto(s) se les reconstruyó la carpeta .git."

#: modprojects:rssummarywouldrebuild
msgid "%d project(s) would have their .git folder rebuilt (dry run)."
msgstr "A %d proyecto(s) se les reconstruiría la carpeta .git (simulación)."

#: modprojects:rsoptremoveextra
msgid "Remove extra chunks"
msgstr "Quitar fragmentos sobrantes"

#: modprojects:rsoptremoveextrahelp
msgid "On Run, delete chunk files that no compared source has (the listed sources and en_ulb), when every verse in them is also in another chunk"
msgstr "Al ejecutar, eliminar los archivos de fragmentos que ninguna fuente comparada tiene (las fuentes listadas y en_ulb), cuando todos los versículos que contienen también están en otro fragmento"

#: modprojects:rsextrachunks
msgid "Chunks no compared source has: %s."
msgstr "Fragmentos que ninguna fuente comparada tiene: %s."

#: modprojects:rsextraline
msgid "  %s: added by %s; \"%s\""
msgstr "  %s: agregado por %s; \"%s\""

#: modprojects:rsextranohistory
msgid "not in git history"
msgstr "no está en el historial de git"

#: modprojects:rsextrahint
msgid " Remove extra chunks (--remove-extra-chunks) deletes them on Run."
msgstr " Quitar fragmentos sobrantes (--remove-extra-chunks) los elimina al ejecutar."

#: modprojects:rsextrakept
msgid "%s holds verses no other chunk has (%s); kept, to be sorted out by hand."
msgstr "%s contiene versículos que ningún otro fragmento tiene (%s); se conservó, para resolverlo manualmente."

#: modprojects:rsextrawouldremove
msgid "Would remove: %s (dry run)."
msgstr "Se quitaría: %s (simulación)."

#: modprojects:rsextraremoved
msgid "Removed %s, and committed."
msgstr "Se quitó %s y se confirmó."

#: modprojects:rsextrafailed
msgid "Could not remove the extra chunks: %s"
msgstr "No se pudieron quitar los fragmentos sobrantes: %s"

#: modprojects:rsextramessage
msgid "Remove chunks no source has (BTT Workbench)"
msgstr "Quitar fragmentos que ninguna fuente tiene (BTT Workbench)"

#: modprojects:rsextraloose
msgid "Uncommitted work, before removing extra chunks"
msgstr "Trabajo sin confirmar, antes de quitar fragmentos sobrantes"

#: modprojects:rssummaryremovedextra
msgid "%d extra chunk(s) removed."
msgstr "%d fragmento(s) sobrante(s) quitado(s)."

#: modprojects:rssummarywouldremoveextra
msgid "%d extra chunk(s) would be removed (dry run)."
msgstr "%d fragmento(s) sobrante(s) se quitarían (simulación)."

#: modprojects:rssummarywouldrename
msgid "%d project(s) would be moved from git branch main to master."
msgstr "%d proyecto(s) pasarían de la rama main de git a master."

#: modprojects:rsconflicts
msgid "%d chunk(s) have unresolved conflicts: %s"
msgstr "%d fragmento(s) tienen conflictos sin resolver: %s"

#: modprojects:rsunreadableconflicts
msgid "%d chunk(s) have conflict markers BTT-Writer cannot read: %s"
msgstr "%d fragmento(s) tienen marcadores de conflicto que BTT-Writer no puede leer: %s"

#: modprojects:rsfinishednofile
msgid "Marked finished but have no file: %s"
msgstr "Marcados como terminados pero sin archivo: %s"

#: modprojects:rsnotchecked
msgid "Chunking is only checked for text projects."
msgstr "La fragmentación solo se revisa en proyectos de texto."

#: modprojects:rssourcemissing
msgid "Source %s is neither downloaded nor bundled with BTT-Writer, so its chunking was not checked."
msgstr "La fuente %s no está descargada ni incluida con BTT-Writer, por lo que no se revisó su fragmentación."

#: modprojects:rsunknownbook
msgid "No en_ulb text for book \"%s\"; is the book code right?"
msgstr "No hay texto en_ulb para el libro \"%s\"; ¿es correcto el código del libro?"

#: modprojects:rssourcelisted
msgid "%s (listed as a source)"
msgstr "%s (listada como fuente)"

#: modprojects:rssourcealways
msgid "%s (always compared)"
msgstr "%s (siempre se compara)"

#: modprojects:rssourceline
msgid "Compared with %s: %s."
msgstr "Comparado con %s: %s."

#: modprojects:rsnoextra
msgid "no extra chunks"
msgstr "sin fragmentos sobrantes"

#: modprojects:rsextra
msgid "extra chunks (not in it; BTT-Writer does not show them with it): %s"
msgstr "fragmentos sobrantes (no están en ella; BTT-Writer no los muestra con ella): %s"

#: modprojects:rsnomissing
msgid "no chunks missing"
msgstr "sin fragmentos faltantes"

#: modprojects:rsmissing
msgid "missing %s"
msgstr "falta %s"

#: modprojects:rsmissingcovered
msgid "missing %s, whose verses are in other chunks here"
msgstr "falta %s, cuyos versículos están en otros fragmentos de aquí"

#: modprojects:rsnooutside
msgid "verse markers all in its chunks"
msgstr "todos los marcadores de versículo están en sus fragmentos"

#: modprojects:rsoutside
msgid "verse markers outside its chunks (BTT-Writer drops them when the chunk is opened with it): %s"
msgstr "marcadores de versículo fuera de sus fragmentos (BTT-Writer los descarta cuando el fragmento se abre con ella): %s"

#: modprojects:rsmatches
msgid "Matches %s: nothing is lost when the project is opened with it."
msgstr "Coincide con %s: no se pierde nada cuando el proyecto se abre con ella."

#: modprojects:rsothersdiffer
msgid " The differences from %s are only another chunking; they matter only if the project is opened with that source."
msgstr " Las diferencias con %s son solo otra fragmentación; importan únicamente si el proyecto se abre con esa fuente."

#: modprojects:rsnonematches
msgid "No compared source matches this project's chunks and verse markers."
msgstr "Ninguna fuente comparada coincide con los fragmentos y marcadores de versículo de este proyecto."

#: modprojects:rsversestwice
msgid "Verse markers given twice in one chunk: %s"
msgstr "Marcadores de versículo repetidos en un mismo fragmento: %s"

#: modprojects:rsmore
msgid "%s and %d more"
msgstr "%s y %d más"

#: modsettings:rstitle
